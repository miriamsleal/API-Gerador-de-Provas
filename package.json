{
  "name": "gerador-provas-api",
  "version": "1.0.0",
  "description": "API para gerador de provas automáticas",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch generated/prisma --ext js,ts,json --exec tsx src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:pratica": "vitest run --exclude tests/security.test.js && vitest run tests/security.test.js -t Prática",
    "test:atividade": "vitest run tests/security.test.js -t Atividade",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures:upload": "node tests/fixtures/createUploadFixtures.js",
    "serve:avaliacao": "tsx tests/serve-evaluation.js"
  },
  "keywords": [
    "api",
    "rest",
    "education",
    "provas"
  ],
  "author": "Míriam Souza Leal",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@uploadcare/upload-client": "^6.25.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
